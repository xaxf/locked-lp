  '4-2-3-1': [[50,91],[13,75],[38,77],[62,77],[87,75],[36,60],[64,60],[17,38],[50,40],[83,38],[50,19]],
  '4-1-4-1': [[50,91],[13,75],[38,77],[62,77],[87,75],[50,62],[12,45],[37,45],[63,45],[88,45],[50,20]],
