  '5-3-2':   [[50,91],[9,71],[29,78],[50,80],[71,78],[91,71],[27,52],[50,55],[73,52],[36,24],[64,24]],
  '5-4-1':   [[50,91],[9,71],[29,78],[50,80],[71,78],[91,71],[12,50],[37,52],[63,52],[88,50],[50,22]],
  '3-4-1-2': [[50,91],[26,76],[50,78],[74,76],[12,55],[37,57],[63,57],[88,55],[50,38],[36,20],[64,20]],
};

/* ---------------- state ---------------- */
const blank = () => ({
  team:'',
  formation:'4-4-2',
  players: Array.from({length:11}, (_,i) => ({name:'', num:i+1, slots:[null,null]})),
  positions: Array(11).fill(null),   // per-player [x,y] overrides, null = use formation
  shoot: WEAPONS.filter(w=>w.shoot).map(w=>w.id),
  iframe: WEAPONS.filter(w=>w.iframe).map(w=>w.id),
});
let S = blank();
let selected = 0;      // player index
let armed = 0;         // which slot the next weapon pick fills
let filter = 'all';    // rarity filter for the index

const clamp = (v,lo,hi) => Math.min(hi, Math.max(lo, v));
const posOf = i => (S.positions && S.positions[i]) || FORMATIONS[S.formation][i];
const label = i => S.players[i].name || `Player ${i+1}`;

/* ---------------- rules ---------------- */
function usage(){
  const map = {};                       // weaponId -> [{p, slot, variant}]
  S.players.forEach((p,pi) => p.slots.forEach((s,si) => {
    if(!s) return;
    (map[s.id] = map[s.id] || []).push({p:pi, slot:si, variant:s.variant});
  }));
  return map;
}
const isShoot  = id => S.shoot.includes(id);
const isIframe = id => S.iframe.includes(id);

function audit(){
  const u = usage(), errs = [], warns = [];
  const nm = i => `${label(i)} (#${S.players[i].num})`;
  const bad = new Set();               // "playerIndex:slotIndex" for tokens to mark red

  // hard caps
  WEAPONS.forEach(w => {
    const hits = u[w.id] || [];
    if(w.cap != null && hits.length > w.cap){
      errs.push(`${w.name}: ${hits.length} fitted, the league allows ${w.cap}.`);
      hits.forEach(h => bad.add(h.p+':'+h.slot));
    }
    if(w.variants){
      w.variants.forEach(v => {
        const vh = hits.filter(h => h.variant === v);
        if(vh.length > 1){
          errs.push(`${w.name} — ${v}: ${vh.length} fitted, only 1 allowed.`);
          vh.forEach(h => bad.add(h.p+':'+h.slot));
        }
      });
      const noVar = hits.filter(h => !h.variant);
      if(noVar.length) warns.push(`${w.name} needs a variant picked (${w.variants.join(' / ')}).`);
    }
  });

  // iFrame dribble cap
  const ifr = WEAPONS.filter(w => isIframe(w.id)).flatMap(w => (u[w.id]||[]).map(h => ({...h, w})));
  if(ifr.length > 2){
    errs.push(`${ifr.length} iFrame dribble moves fitted — 2 per team.`);
    ifr.forEach(h => bad.add(h.p+':'+h.slot));
  }

  // Primal Handstand: GK only
  (u['primal-handstand'] || []).forEach(h => {
    if(h.p !== 0){ errs.push(`Primal Handstand is on ${nm(h.p)} — goalkeeper only.`); bad.add(h.p+':'+h.slot); }
  });
  // Pairing rules: Direct Shot and Emperor
  [['direct-shot','Direct Shot'],['emperor-impact','Emperor']].forEach(([id,label]) => {
    const hits = u[id] || [];
    if(hits.length === 2){
      const solo = hits.filter(h => {
        const other = S.players[h.p].slots[1-h.slot];
        return !other || !isShoot(other.id);
      });
      if(solo.length === 0){
        errs.push(`Two ${label}s fitted and both share a player with another shooting weapon. One has to run ${label} alone.`);
        hits.forEach(h => bad.add(h.p+':'+h.slot));
      }
    }
  });

  // duplicates on one player + empty slots
  S.players.forEach((p,pi) => {
    if(p.slots[0] && p.slots[1] && p.slots[0].id === p.slots[1].id){
      errs.push(`${nm(pi)} has ${BY_ID[p.slots[0].id].name} twice.`);
      bad.add(pi+':0'); bad.add(pi+':1');
    }
  });
  const empty = S.players.filter(p => !p.slots[0] || !p.slots[1]).length;
  if(empty) warns.push(`${empty} player${empty>1?'s':''} still ${empty>1?'have':'has'} an open weapon slot.`);

  return {errs, warns, bad, u};
}

/* ---------------- render ---------------- */
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function shirtSVG(num){
  return `<svg class="shirt" viewBox="0 0 64 60" aria-hidden="true">
    <path d="M18 5 L3 13 L7 29 L17 25 L17 57 L47 57 L47 25 L57 29 L61 13 L46 5 Z" fill="#fff"/>
    <path d="M18 6 L17 24 L17 56 L47 56 L47 24 L46 6 C42 12 22 12 18 6 Z" fill="var(--kit)"/>
    <ellipse cx="32" cy="6.5" rx="7.5" ry="3.2" fill="#fff"/>
    <text x="32" y="41" text-anchor="middle" font-family="Space Grotesk, system-ui, sans-serif"
      font-size="22" font-weight="700" fill="#fff">${num}</text>
  </svg>`;
}

function renderPitch(){
  const pitch = $('#pitch');
  pitch.querySelectorAll('.tok').forEach(n => n.remove());
  const {bad} = audit();
  S.players.forEach((p,i) => {
    const [x,y] = posOf(i);
    const el = document.createElement('div');
    el.className = 'tok' + (i === selected ? ' sel' : '');
    el.style.left = x + '%'; el.style.top = y + '%';
    el.tabIndex = 0;
    el.setAttribute('role','button');
    el.setAttribute('aria-label', `${label(i)}, number ${p.num}. Drag to move, arrow keys to nudge.`);
    const arms = p.slots.map((s,si) => {
      if(!s) return `<span class="arm empty" title="Empty slot"></span>`;
      const w = BY_ID[s.id];
      const v = s.variant ? ` — ${s.variant}` : '';
      return `<span class="arm${bad.has(i+':'+si)?' viol':''}" style="background-image:url(${w.art})" title="${esc(w.name+v)}"></span>`;
    }).join('');
    const nameHTML = p.name
      ? `<span class="nm" title="Click to rename">${esc(p.name)}</span>`
      : `<span class="nm ph" title="Click to add a name">Add name</span>`;
    el.innerHTML = shirtSVG(p.num) + nameHTML + `<span class="arms">${arms}</span>`;
    attachToken(el, i);
    pitch.appendChild(el);
  });
  $('#pitchMeta').textContent = S.formation;
}

function attachToken(el, i){
  let pid = null, sx = 0, sy = 0, moved = false, rect = null, start = null, onName = false;

  el.addEventListener('pointerdown', e => {
    if(e.button) return;
    if(el.querySelector('.nmedit')) return;      // renaming: leave the input alone
    pid = e.pointerId; moved = false;
    onName = !!(e.target.closest && e.target.closest('.nm'));
    sx = e.clientX; sy = e.clientY;
    rect = $('#pitch').getBoundingClientRect();
    start = posOf(i).slice();
    el.setPointerCapture(pid);
    el.classList.add('grabbing');
  });

  el.addEventListener('pointermove', e => {
    if(pid === null || e.pointerId !== pid) return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if(!moved && Math.hypot(dx, dy) < 4) return;
    if(!moved){ moved = true; el.classList.add('dragging'); }
    const nx = clamp(start[0] + dx / rect.width  * 100, 3, 97);
    const ny = clamp(start[1] + dy / rect.height * 100, 3, 97);
    S.positions[i] = [nx, ny];
    el.style.left = nx + '%'; el.style.top = ny + '%';
  });

  const finish = e => {
    if(pid === null || (e.pointerId !== undefined && e.pointerId !== pid)) return;
    try{ el.releasePointerCapture(pid); }catch(err){}
    pid = null;
    el.classList.remove('grabbing','dragging');
    if(moved) return;                            // it was a drag, not a click
    selected = i; armed = S.players[i].slots[0] ? (S.players[i].slots[1] ? 0 : 1) : 0;
    renderAll();
    if(onName) editName(i);
  };
  el.addEventListener('pointerup', finish);
  el.addEventListener('pointercancel', finish);

  el.addEventListener('keydown', e => {
    if(e.key === 'Enter' || e.key === ' '){
      e.preventDefault(); selected = i; armed = 0; renderAll();
      $('#pitch').querySelectorAll('.tok')[i].focus();
      return;
    }
    if(e.key === 'F2'){ e.preventDefault(); editName(i); return; }
    const step = e.shiftKey ? 5 : 1;
    const c = posOf(i).slice();
    if(e.key === 'ArrowLeft')       c[0] -= step;
    else if(e.key === 'ArrowRight') c[0] += step;
    else if(e.key === 'ArrowUp')    c[1] -= step;
    else if(e.key === 'ArrowDown')  c[1] += step;
    else return;
    e.preventDefault();
    S.positions[i] = [clamp(c[0],3,97), clamp(c[1],3,97)];
    el.style.left = S.positions[i][0] + '%';
    el.style.top  = S.positions[i][1] + '%';
  });
}

function editName(i){
  const el = $('#pitch').querySelectorAll('.tok')[i];
  if(!el || el.querySelector('.nmedit')) return;
  const span = el.querySelector('.nm');
  if(!span) return;
  const inp = document.createElement('input');
  inp.type = 'text'; inp.className = 'nmedit'; inp.value = S.players[i].name;
  inp.placeholder = `Player ${i+1}`;
  inp.setAttribute('aria-label', `Name for player ${i+1}`);
  inp.maxLength = 18;
  span.replaceWith(inp);
  inp.focus(); inp.select();
  let done = false;
  const commit = keep => {
    if(done) return; done = true;
    if(keep) S.players[i].name = inp.value.trim();
    renderAll();
    const t = $('#pitch').querySelectorAll('.tok')[i];
    if(t) t.focus();
  };
  inp.addEventListener('blur', () => commit(true));
  inp.addEventListener('pointerdown', e => e.stopPropagation());
  inp.addEventListener('keydown', e => {
    e.stopPropagation();
    if(e.key === 'Enter'){ e.preventDefault(); commit(true); }
    else if(e.key === 'Escape'){ e.preventDefault(); commit(false); }
  });
}

function renderIssues(){
  const {errs, warns} = audit();
  const host = $('#issues');
  const rows = [
    ...errs.map(t => `<div class="issue err"><span class="dot"></span><span>${esc(t)}</span></div>`),
    ...warns.map(t => `<div class="issue"><span class="dot"></span><span>${esc(t)}</span></div>`),
  ];
  host.innerHTML = rows.length ? rows.join('')
    : `<div class="issue ok"><span class="dot"></span><span>Squad is legal — every rule checks out.</span></div>`;
}

function renderEditor(){
  const p = S.players[selected];
  $('#editorWho').textContent = (selected === 0 ? 'Goalkeeper' : 'Outfield') + ` · ${label(selected)}`;
  const ed = $('#editor');
  ed.innerHTML = `
    <div class="row">
      <div class="field grow"><label for="pname">Name</label>
        <input type="text" id="pname" class="grow" placeholder="Player ${selected+1}" value="${esc(p.name)}"></div>
      <div class="field"><label for="pnum">Number</label>
        <input type="text" id="pnum" size="3" value="${esc(p.num)}"></div>
    </div>
    <div class="slots">${p.slots.map((s,i) => slotHTML(s,i)).join('')}</div>
    <div class="notes" id="noteHost"></div>`;
  $('#pname').oninput = e => { p.name = e.target.value; renderPitch(); $('#editorWho').textContent = (selected===0?'Goalkeeper':'Outfield') + ` · ${label(selected)}`; };
  $('#pnum').oninput  = e => { p.num  = e.target.value.replace(/\D/g,'').slice(0,2); renderPitch(); };
  ed.querySelectorAll('.slot').forEach(b => {
    b.onclick = () => {
      const i = +b.dataset.i;
      if(p.slots[i]){ p.slots[i] = null; armed = i; }
      else armed = i;
      renderAll();
    };
  });
  const notes = p.slots.filter(Boolean).map(s => {
    const w = BY_ID[s.id];
    return `<div class="notebox"><b>${esc(w.name)}${s.variant ? ' — ' + esc(s.variant) : ''}.</b> ${esc(w.note)}</div>`;
  }).join('');
  $('#noteHost').innerHTML = notes || `<div class="notebox">Pick a slot, then choose a weapon below.</div>`;
}

function slotHTML(s,i){
  if(!s) return `<button class="slot${armed===i?' armed':''}" data-i="${i}">
      <span class="hint">Slot ${i+1} — ${armed===i?'choose a weapon':'tap to arm'}</span></button>`;
  const w = BY_ID[s.id];
  return `<button class="slot filled" data-i="${i}" style="border-color:var(--${w.rarity})" title="Tap to clear">
      <img src="${w.art}" alt="">
      <span class="txt"><b>${esc(w.name)}</b><small>${s.variant ? esc(s.variant) : w.rarity}</small></span></button>`;
}

function renderChips(){
  const host = $('#chips');
  const opts = [{key:'all',label:'All'}, ...RARITY.map(r => ({key:r.key,label:r.label}))];
  host.innerHTML = opts.map(o =>
    `<button class="chip${filter===o.key?' on':''}" data-k="${o.key}"
       style="${o.key==='all'?'':`color:${filter===o.key?`var(--${o.key})`:''}`}">${o.label}</button>`).join('');
  host.querySelectorAll('.chip').forEach(c => c.onclick = () => { filter = c.dataset.k; renderChips(); renderIndex(); });
}

function renderIndex(){
  const q = ($('#search').value || '').toLowerCase().trim();
  const {u} = audit();
  const host = $('#index'); host.innerHTML = '';
  let shown = 0;
  RARITY.forEach(r => {
    if(filter !== 'all' && filter !== r.key) return;
    const list = WEAPONS.filter(w => w.rarity === r.key && w.name.toLowerCase().includes(q));
    if(!list.length) return;
    shown += list.length;
    host.insertAdjacentHTML('beforeend',
      `<div class="band ${r.key}"><span class="rname">${r.label}</span>
        <span class="stars">${'\u2605'.repeat(r.stars)}${'\u2606'.repeat(5-r.stars)}</span>
        <span class="pct">${r.pct}</span></div><div class="tiles" data-r="${r.key}"></div>`);
    const grid = host.querySelector(`.tiles[data-r="${r.key}"]`);
    list.forEach(w => {
      const n = (u[w.id] || []).length;
      const maxed = w.cap != null && n >= w.cap;
      const tag = w.cap != null ? `<span class="tag">${n}/${w.cap}</span>` : '';
      const b = document.createElement('button');
      b.className = `tile ${w.rarity}${maxed ? ' maxed' : ''}`;
      b.title = w.note;
      b.innerHTML = `<img src="${w.art}" alt=""><span class="cap">${esc(w.name)}</span>${tag}`;
      b.onclick = () => fit(w);
      grid.appendChild(b);
    });
  });
  if(!shown) host.innerHTML = `<div class="empty-idx">No weapon matches that search.</div>`;
  const total = S.players.reduce((a,p) => a + p.slots.filter(Boolean).length, 0);
  $('#idxMeta').textContent = `${total} / 22 fitted`;
}

function fit(w){
  const p = S.players[selected];
  let i = p.slots[armed] ? (p.slots[0] ? (p.slots[1] ? armed : 1) : 0) : armed;
  const place = variant => { p.slots[i] = {id:w.id, variant}; armed = i === 0 ? 1 : 0; renderAll(); };
  if(w.variants) askVariant(w, place); else place(null);
}

function askVariant(w, cb){
  const dlg = $('#varDlg');
  $('#varTitle').textContent = `${w.name} — pick a variant`;
  const body = $('#varBody'); body.innerHTML = '';
  w.variants.forEach(v => {
    const b = document.createElement('button');
    b.className = 'btn'; b.textContent = v;
    b.onclick = () => { dlg.close(); cb(v); };
    body.appendChild(b);
  });
  const c = document.createElement('button');
  c.className = 'btn'; c.textContent = 'Cancel'; c.onclick = () => dlg.close();
  body.appendChild(c);
  dlg.showModal();
}

function renderAll(){
  renderPitch(); renderEditor(); renderIndex(); renderIssues();
}

/* ---------------- image export (drawn on canvas, no network) ------------- */
const IMG_CACHE = {};
function loadArt(w){
  if(IMG_CACHE[w.id]) return Promise.resolve(IMG_CACHE[w.id]);
  return new Promise(res => {
    const im = new Image();
    im.onload = () => { IMG_CACHE[w.id] = im; res(im); };
    im.onerror = () => res(null);
    im.src = w.art;
  });
}
const DISP = w => `${w} "Space Grotesk",system-ui,sans-serif`;

function drawPitch(g, ox, oy, w, h){
  const bands = 14, bh = h / bands;
  for(let i = 0; i < bands; i++){
    g.fillStyle = i % 2 ? '#347a2c' : '#3d8a34';
    g.fillRect(ox, oy + i * bh, w, bh + .6);
  }
  g.strokeStyle = 'rgba(255,255,255,.85)'; g.lineWidth = Math.max(2, w * .003);
  const L = ox + w * .04, R = ox + w * .96, T = oy + h * .022, B = oy + h * .978;
  g.strokeRect(L, T, R - L, B - T);
  g.beginPath(); g.moveTo(L, oy + h / 2); g.lineTo(R, oy + h / 2); g.stroke();
  g.beginPath(); g.arc(ox + w / 2, oy + h / 2, w * .13, 0, Math.PI * 2); g.stroke();
  g.fillStyle = '#fff';
  g.beginPath(); g.arc(ox + w / 2, oy + h / 2, w * .006, 0, Math.PI * 2); g.fill();

  [[B, -1],[T, 1]].forEach(([edge, dir]) => {
    const boxH = h * .14, sixH = h * .06;
    const bx = ox + w * .22, bw = w * .56;
    g.strokeRect(bx, dir < 0 ? edge - boxH : edge, bw, boxH);
    g.strokeRect(ox + w * .36, dir < 0 ? edge - sixH : edge, w * .28, sixH);
    const spotY = edge + dir * h * .105;
    g.beginPath(); g.arc(ox + w / 2, spotY, w * .006, 0, Math.PI * 2); g.fill();
    g.save();                                   // penalty arc, clipped outside the box
    const boxEdgeY = edge + dir * boxH;
    g.beginPath();
    g.rect(bx, dir < 0 ? oy : boxEdgeY, bw, dir < 0 ? boxEdgeY - oy : oy + h - boxEdgeY);
    g.clip();
    g.beginPath(); g.arc(ox + w / 2, spotY, w * .13, 0, Math.PI * 2); g.stroke();
    g.restore();
  });
}

const SHIRT_OUT = new Path2D('M18 5 L3 13 L7 29 L17 25 L17 57 L47 57 L47 25 L57 29 L61 13 L46 5 Z');
const SHIRT_RED = new Path2D('M18 6 L17 24 L17 56 L47 56 L47 24 L46 6 C42 12 22 12 18 6 Z');
function drawShirt(g, cx, topY, w, num){
  const s = w / 64;
  g.save(); g.translate(cx - w / 2, topY); g.scale(s, s);
  g.fillStyle = '#ffffff'; g.fill(SHIRT_OUT);
  g.fillStyle = '#d63a3a'; g.fill(SHIRT_RED);
  g.fillStyle = '#ffffff';
  g.beginPath(); g.ellipse(32, 6.5, 7.5, 3.2, 0, 0, Math.PI * 2); g.fill();
  g.font = DISP('700 22px'); g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillText(String(num), 32, 40);
  g.restore();
}

async function exportPNG(){
  const btn = $('#btnImg'); const old = btn.textContent; btn.textContent = 'Drawing…';
  try{ if(document.fonts) await document.fonts.ready; }catch(e){}
  const used = [...new Set(S.players.flatMap(p => p.slots.filter(Boolean).map(s => s.id)))];
  await Promise.all(used.map(id => loadArt(BY_ID[id])));

  const W = 900, PH = Math.round(W * 56 / 41), HEAD = 62, FOOT = 16;
  const dpr = 2, c = document.createElement('canvas');
  c.width = W * dpr; c.height = (HEAD + PH + FOOT) * dpr;
  const g = c.getContext('2d'); g.scale(dpr, dpr);

  g.fillStyle = '#0a0b0e'; g.fillRect(0, 0, W, HEAD + PH + FOOT);
  g.textBaseline = 'middle';
  g.fillStyle = '#f1f2f5'; g.font = DISP('700 30px'); g.textAlign = 'left';
  g.fillText((S.team || 'Squad').toUpperCase(), 22, HEAD / 2);
  g.fillStyle = '#3fe0bf'; g.font = DISP('500 19px'); g.textAlign = 'right';
  g.fillText(S.formation, W - 22, HEAD / 2);

  drawPitch(g, 0, HEAD, W, PH);

  const {bad} = audit();
  S.players.forEach((p, i) => {
    const [px, py] = posOf(i);
    const cx = px / 100 * W, cy = HEAD + py / 100 * PH;
    const sw = W * .105, sh = sw * 60 / 64;
    drawShirt(g, cx, cy - sh * .62, sw, p.num);
    const nameY = cy - sh * .62 + sh + 13;
    if(p.name){
      g.textAlign = 'center';
      g.font = DISP('600 20px');
      g.lineWidth = 4; g.strokeStyle = 'rgba(0,0,0,.65)';
      g.strokeText(p.name, cx, nameY);
      g.fillStyle = '#ffffff';
      g.fillText(p.name, cx, nameY);
    }
    const ic = 26, gap = 4, y0 = nameY + (p.name ? 12 : 2);
    p.slots.forEach((s, si) => {
      const x0 = cx - ic - gap / 2 + si * (ic + gap);
      g.fillStyle = 'rgba(6,9,18,.6)';
      g.fillRect(x0, y0, ic, ic);
      if(s && IMG_CACHE[s.id]){
        g.save(); g.beginPath(); g.rect(x0, y0, ic, ic); g.clip();
        const im = IMG_CACHE[s.id], r = Math.max(ic / im.width, ic / im.height);
        g.drawImage(im, x0 + (ic - im.width * r) / 2, y0 + (ic - im.height * r) / 2,
                    im.width * r, im.height * r);
        g.restore();
      }
      g.lineWidth = 1.6;
      g.strokeStyle = bad.has(i + ':' + si) ? '#ff5f70' : (s ? 'rgba(255,255,255,.65)' : 'rgba(255,255,255,.3)');
      g.strokeRect(x0 + .8, y0 + .8, ic - 1.6, ic - 1.6);
    });
  });

  c.toBlob(blob => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = (S.team || 'squad').replace(/\W+/g, '-').toLowerCase() + '-lineup.png';
    a.click(); URL.revokeObjectURL(a.href);
    btn.textContent = old;
  }, 'image/png');
}

/* ---------------- wiring ---------------- */
const fsel = $('#formation');
Object.keys(FORMATIONS).forEach(f => {
  const o = document.createElement('option'); o.value = o.textContent = f; fsel.appendChild(o);
});
fsel.value = S.formation;
fsel.onchange = e => {
  S.formation = e.target.value;
  S.positions = Array(11).fill(null);   // a new shape starts from its own spots
  renderPitch();
};
$('#btnPos').onclick = () => { S.positions = Array(11).fill(null); renderPitch(); };
$('#teamname').oninput = e => { S.team = e.target.value; };
$('#search').oninput = renderIndex;

$('#btnImg').onclick = exportPNG;
$('#btnReset').onclick = () => {
  if(!confirm('Clear every player and weapon?')) return;
  S = blank(); selected = 0; armed = 0;
  $('#teamname').value = S.team; fsel.value = S.formation; renderAll();
};
$('#btnSave').onclick = () => {
  const blob = new Blob([JSON.stringify(S,null,2)],{type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = (S.team || 'squad').replace(/\W+/g,'-').toLowerCase() + '-locked2.json';
  a.click(); URL.revokeObjectURL(a.href);
};
$('#btnLoad').onclick = () => $('#fileIn').click();
$('#fileIn').onchange = e => {
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = () => {
    try{
      const d = JSON.parse(r.result);
      S = Object.assign(blank(), d);
      if(!Array.isArray(S.positions) || S.positions.length !== 11) S.positions = Array(11).fill(null);
      $('#teamname').value = S.team; fsel.value = S.formation;
      selected = 0; armed = 0; renderAll();
    }catch(err){ alert('That file is not a saved squad.'); }
  };
  r.readAsText(f); e.target.value = '';
};
$('#btnCopy').onclick = () => {
  const lines = [`${S.team || 'Squad'} — ${S.formation}`];
  S.players.forEach((p,i) => {
    const w = p.slots.map(s => s ? BY_ID[s.id].name + (s.variant ? ` (${s.variant})` : '') : '—').join(' + ');
    lines.push(`${String(p.num).padStart(2,' ')}  ${label(i).padEnd(12)} ${w}`);
  });
  const text = lines.join('\n');
  navigator.clipboard?.writeText(text).then(
    () => { const b = $('#btnCopy'); b.textContent = 'Copied'; setTimeout(() => b.textContent = 'Copy list', 1200); },
    () => prompt('Copy your squad:', text));
};

renderChips();
renderAll();
</script>
