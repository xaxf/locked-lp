s included), never in the box — penalty.", "variants": null, "gkOnly": false, "art": "data:image/png;base64,"}, {"id": "direct-shot", "name": "Direct Shot", "rarity": "common", "cap": 2, "shoot": true, "iframe": false, "note": "A second Direct Shot has to be played alone, with no other shooting weapon on that player — penalty + yellow.", "variants": null, "gkOnly": false, "art": "data:image/png;base64,"}, {"id": "bear-claw", "name": "Bear Claw", "rarity": "common", "cap": null, "shoot": false, "iframe": false, "note": "No weapon-specific restriction in the rulebook.", "variants": null, "gkOnly": false, "art": "data:image/png;base64,"}, {"id": "stylish-reach", "name": "Stylish Reach", "rarity": "common", "cap": 2, "shoot": false, "iframe": false, "note": "Never on the goalkeeper — straight red card.", "variants": null, "gkOnly": false, "art": "data:image/png;base64,"}, {"id": "explosive-acceleration", "name": "Explosive Acceleration", "rarity": "common", "cap": null, "shoot": false, "iframe": false, "note": "No weapon-specific restriction in the rulebook.", "variants": null, "gkOnly": false, "art": "data:image/png;base64,"}];
const BY_ID = Object.fromEntries(WEAPONS.map(w => [w.id, w]));
const RARITY = [
  {key:'unique',    label:'Unique',    pct:'1%',  stars:5},
  {key:'legendary', label:'Legendary', pct:'5%',  stars:4},
  {key:'epic',      label:'Epic',      pct:'20%', stars:3},
