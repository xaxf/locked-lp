<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lineup Builder</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0b0e; --surface:#121419; --surface2:#181b21; --raised:#212530;
  --edge:#262a33; --edge2:#333845;
  --ink:#f1f2f5; --ink2:#c2c7d1; --mute:#7d8494;
  --accent:#3fe0bf; --accent-ink:#04241e;
  --alarm:#ff5f70;
  --unique:#ef4a63; --legendary:#e2748e; --epic:#a78bfa; --rare:#5fa5fb; --common:#9aa2b2;
  --turf-a:#3d8a34; --turf-b:#347a2c; --kit:#d63a3a;
  --disp:"Space Grotesk",system-ui,sans-serif;
  --body:"DM Sans",system-ui,-apple-system,sans-serif;
  --r:4px;      /* card / panel radius */
  --r2:3px;     /* control radius */
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:
    radial-gradient(1100px 620px at 8% -18%,rgba(63,224,191,.06),transparent 62%),
    radial-gradient(820px 520px at 96% 2%,rgba(167,139,250,.06),transparent 60%),
    var(--bg);
  background-attachment:fixed;
  color:var(--ink); font-family:var(--body); font-size:14px; line-height:1.55;
  min-height:100vh; -webkit-font-smoothing:antialiased;
}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:var(--r2)}

/* ---------- shell ---------- */
.wrap{max-width:1420px;margin:0 auto;padding:28px 24px 72px}
header.top{
  display:flex;flex-wrap:wrap;gap:14px;align-items:center;
  padding:0 2px 18px;margin-bottom:24px;border-bottom:1px solid var(--edge);
}
header.top .spacer{flex:1 1 auto;min-width:0}
.brand{
  font-family:var(--disp);font-weight:700;font-size:15px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink);margin-right:6px;
}
.credit{
  font-family:var(--disp);font-weight:500;font-size:10.5px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--mute);margin-right:8px;white-space:nowrap;
}
.credit b{color:var(--accent);font-weight:600}
footer.shout{
  margin-top:34px;padding:16px 2px 0;border-top:1px solid var(--edge);
  font-family:var(--disp);font-weight:500;font-size:11px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--mute);text-align:center;
}
footer.shout b{color:var(--ink2);font-weight:600}
.field{display:flex;align-items:center;gap:9px}
.field label{
  font-family:var(--disp);font-weight:500;text-transform:uppercase;
  letter-spacing:.1em;font-size:10.5px;color:var(--mute);
}
select,input[type=text]{
  background:#0d0f13;border:1px solid var(--edge2);border-radius:var(--r2);color:var(--ink);
  padding:9px 11px;font-family:var(--body);font-size:13.5px;transition:border-color .15s;
}
select{font-family:var(--disp);font-weight:500}
select:hover,input[type=text]:hover{border-color:#454b5b}
input[type=text]:focus,select:focus{border-color:var(--accent);outline:none}
.btn{
  border:1px solid var(--edge2);background:var(--raised);border-radius:var(--r2);padding:9px 14px;
  font-family:var(--disp);font-weight:500;font-size:12.5px;color:var(--ink2);
  transition:background .15s,border-color .15s,color .15s;white-space:nowrap;
}
.btn:hover{background:#2a2f3c;border-color:#454b5b;color:var(--ink)}
.btn.accent{background:var(--accent);border-color:transparent;color:var(--accent-ink);font-weight:700}
.btn.accent:hover{background:#54ecce;color:var(--accent-ink)}
.btn.tiny{padding:5px 10px;font-size:11px}
.btnset{display:flex;gap:0}
.btnset .btn{border-radius:0;margin-left:-1px}
.btnset .btn:first-child{border-radius:var(--r2) 0 0 var(--r2);margin-left:0}
.btnset .btn:last-child{border-radius:0 var(--r2) var(--r2) 0}

/* ---------- layout ---------- */
.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,440px);gap:26px;align-items:start}
@media(max-width:1040px){.grid{grid-template-columns:1fr}}
.card{
  border:1px solid var(--edge);background:var(--surface);border-radius:var(--r);
  box-shadow:0 1px 0 rgba(255,255,255,.02) inset;
}
.card>h2{
  margin:0;padding:14px 18px;font-family:var(--disp);font-weight:600;font-size:11.5px;
  letter-spacing:.12em;text-transform:uppercase;color:var(--mute);
  border-bottom:1px solid var(--edge);
  display:flex;justify-content:space-between;align-items:center;gap:12px;
}
.card>h2 em{font-style:normal;color:var(--accent);letter-spacing:.04em;font-weight:500;text-transform:none}
.h2r{display:flex;align-items:center;gap:10px}
.rightcol{display:flex;flex-direction:column;gap:26px}

/* ---------- pitch ---------- */
.pitchwrap{padding:20px}
.pitch{
  position:relative;width:min(100%,calc(74vh * 41 / 56));aspect-ratio:41/56;
  margin:0 auto;border-radius:2px;overflow:hidden;
  background:repeating-linear-gradient(180deg,var(--turf-a) 0 7.14%,var(--turf-b) 7.14% 14.28%);
  box-shadow:inset 0 0 70px rgba(0,0,0,.4);
}
.pitch .line{position:absolute;border:2px solid rgba(255,255,255,.8)}
.p-out{inset:2.2% 4%}
.p-half{left:4%;right:4%;top:50%;border-width:0 0 2px 0}
.p-circle{left:50%;top:50%;width:26%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%}
.p-spot{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px 0 0 -3px;background:#fff;border-radius:50%}
.p-box-b{left:22%;right:22%;bottom:2.2%;height:14%;border-bottom:0}
.p-box-t{left:22%;right:22%;top:2.2%;height:14%;border-top:0}
.p-six-b{left:36%;right:36%;bottom:2.2%;height:6%;border-bottom:0}
.p-six-t{left:36%;right:36%;top:2.2%;height:6%;border-top:0}
.p-arc-b{left:41%;right:41%;bottom:15.6%;height:5%;border-top:0;border-radius:0 0 50% 50%/0 0 100% 100%}
.p-arc-t{left:41%;right:41%;top:15.6%;height:5%;border-bottom:0;border-radius:50% 50% 0 0/100% 100% 0 0}
.pitchhint{margin:16px 0 0;text-align:center;color:var(--mute);font-size:12px}
.pitchhint b{color:var(--ink2);font-weight:500}

/* player token */
.tok{
  position:absolute;transform:translate(-50%,-50%);width:15%;min-width:62px;
  display:flex;flex-direction:column;align-items:center;gap:3px;
  cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;
}
.tok .shirt{width:100%;filter:drop-shadow(0 4px 6px rgba(0,0,0,.5));transition:transform .14s}
.tok:hover .shirt{transform:translateY(-3px)}
.tok.sel .shirt{transform:translateY(-3px) scale(1.07)}
.tok.grabbing{cursor:grabbing}
.tok.dragging{z-index:30}
.tok.dragging .shirt{transform:translateY(-4px) scale(1.09)}
.tok .nm{
  font-family:var(--disp);font-weight:600;font-size:clamp(10px,1.25vw,13.5px);
  color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.9);
  white-space:nowrap;max-width:132%;overflow:hidden;text-overflow:ellipsis;cursor:text;
}
.tok .nm.ph{color:rgba(255,255,255,.55);font-weight:500}
.tok:hover .nm.ph{color:rgba(255,255,255,.85)}
.tok.sel .nm{color:var(--accent)}
.tok .nmedit{
  width:112%;max-width:132px;text-align:center;font-family:var(--disp);font-weight:600;
  font-size:13px;padding:2px 5px;border-radius:var(--r2);
  border:1px solid var(--accent);background:rgba(6,8,11,.95);color:#fff;
}
.tok .arms{display:flex;gap:3px}
.tok .arm{
  width:clamp(19px,2.3vw,26px);aspect-ratio:1;border-radius:2px;border:1.5px solid rgba(255,255,255,.28);
  background:#0d0f13 center/cover no-repeat;box-shadow:0 2px 5px rgba(0,0,0,.55);
}
.tok .arm.empty{border-style:dashed;border-color:rgba(255,255,255,.4);background:rgba(0,0,0,.3)}
.tok .arm.viol{border-color:var(--alarm);box-shadow:0 0 0 2px rgba(255,95,112,.35)}

/* ---------- issues ---------- */
.issues{border-top:1px solid var(--edge);padding:14px 18px;display:flex;flex-direction:column;gap:8px}
.issue{display:flex;gap:9px;align-items:flex-start;font-size:12.5px;color:var(--ink2);line-height:1.45}
.issue .dot{width:6px;height:6px;border-radius:99px;flex:none;margin-top:6px;background:var(--mute)}
.issue.err .dot{background:var(--alarm)}
.issue.err{color:var(--ink)}
.issue.ok{color:var(--mute)}
.issue.ok .dot{background:var(--accent)}

/* ---------- player editor ---------- */
.editor{padding:18px;display:flex;flex-direction:column;gap:16px}
.row{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.row .grow{flex:1;min-width:120px}
.slots{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.slot{
  border:1px dashed var(--edge2);border-radius:var(--r2);padding:12px;display:flex;gap:12px;
  align-items:center;background:#0d0f13;min-height:74px;text-align:left;width:100%;
  transition:border-color .15s,background .15s;
}
.slot:hover{border-color:#454b5b}
.slot.armed{border-style:solid;border-color:var(--accent);box-shadow:0 0 0 2px rgba(63,224,191,.13)}
.slot.filled{border-style:solid;background:var(--surface2)}
.slot img{width:48px;height:37px;object-fit:cover;border-radius:2px;flex:none}
.slot .txt{min-width:0}
.slot .txt b{
  display:block;font-family:var(--disp);font-weight:600;font-size:13.5px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.slot .txt small{color:var(--mute);font-size:11px}
.slot .hint{font-family:var(--disp);font-weight:500;font-size:11.5px;color:var(--mute)}
.notes{display:flex;flex-direction:column;gap:10px}
.notebox{font-size:12.5px;color:var(--mute);border-left:2px solid var(--edge2);padding-left:12px}
.notebox b{color:var(--ink2);font-weight:500}

/* ---------- weapon index ---------- */
.toolbar{padding:14px 18px;display:flex;flex-direction:column;gap:12px;border-bottom:1px solid var(--edge)}
.toolbar input{width:100%}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{
  border:1px solid var(--edge2);border-radius:var(--r2);padding:5px 11px;
  font-family:var(--disp);font-weight:500;font-size:11px;letter-spacing:.05em;
  text-transform:uppercase;color:var(--mute);transition:all .14s;
}
.chip:hover{color:var(--ink2);border-color:#454b5b}
.chip.on{color:var(--ink);border-color:currentColor;background:rgba(255,255,255,.04)}
.index{max-height:min(58vh,620px);overflow:auto;padding:0 0 14px}
.band{
  position:sticky;top:0;z-index:2;
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:9px 18px;
  font-family:var(--disp);font-weight:600;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;
  border-bottom:1px solid var(--edge);background:var(--surface2);
}
.band .stars{letter-spacing:.14em;font-size:10px;opacity:.9}
.band .pct{font-size:10.5px;font-weight:500;opacity:.7;color:var(--mute)}
.band.unique{color:var(--unique);box-shadow:inset 3px 0 0 var(--unique)}
.band.legendary{color:var(--legendary);box-shadow:inset 3px 0 0 var(--legendary)}
.band.epic{color:var(--epic);box-shadow:inset 3px 0 0 var(--epic)}
.band.rare{color:var(--rare);box-shadow:inset 3px 0 0 var(--rare)}
.band.common{color:var(--common);box-shadow:inset 3px 0 0 var(--common)}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:12px;padding:16px 18px 6px}
.tile{
  border:1px solid var(--edge);border-radius:var(--r2);overflow:hidden;background:#0d0f13;
  display:flex;flex-direction:column;position:relative;text-align:center;
  transition:border-color .14s,background .14s;
}
.tile:hover{border-color:var(--accent);background:#11151a}
.tile img{width:100%;aspect-ratio:142/108;object-fit:cover;display:block}
.tile .cap{
  font-family:var(--disp);font-weight:500;font-size:10.5px;
  padding:7px 6px 8px;line-height:1.25;color:var(--ink2);
}
.tile .tag{
  position:absolute;top:5px;right:5px;font-family:var(--disp);font-weight:500;font-size:9.5px;
  padding:1px 5px;border-radius:2px;background:rgba(6,8,11,.85);
  border:1px solid var(--edge2);color:var(--mute);
}
.tile.maxed{opacity:.4}
.tile.maxed .tag{color:var(--alarm);border-color:rgba(255,95,112,.5)}
.empty-idx{padding:24px 18px;color:var(--mute);font-size:12.5px}

dialog{
  border:1px solid var(--edge2);background:var(--surface);color:var(--ink);border-radius:var(--r);
  padding:0;max-width:340px;width:calc(100% - 32px);
}
dialog::backdrop{background:rgba(4,5,8,.72)}
dialog .dh{
  padding:15px 18px;border-bottom:1px solid var(--edge);font-family:var(--disp);font-weight:600;
  letter-spacing:.1em;text-transform:uppercase;font-size:11.5px;color:var(--mute);
}
dialog .db{padding:18px;display:flex;flex-direction:column;gap:10px}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="wrap">

<header class="top">
  <span class="brand">Lineup</span>
  <span class="credit">made by <b>fangs</b> (@xaxf on ds)</span>
  <div class="field">
    <label for="teamname">Team</label>
    <input type="text" id="teamname" placeholder="Your team" size="14">
  </div>
  <div class="field">
    <label for="formation">Formation</label>
    <select id="formation"></select>
  </div>
  <div class="spacer"></div>
  <div class="btnset">
    <button class="btn" id="btnSave">Save</button>
    <button class="btn" id="btnLoad">Load</button>
    <button class="btn" id="btnCopy">Copy list</button>
    <button class="btn" id="btnReset">Reset</button>
  </div>
  <button class="btn accent" id="btnImg">Download image</button>
  <input type="file" id="fileIn" accept="application/json" hidden>
</header>

<div class="grid">

  <!-- LEFT: pitch -->
  <section class="card">
    <h2>The pitch <span class="h2r"><button class="btn tiny" id="btnPos">Reset positions</button><em id="pitchMeta">4-4-2</em></span></h2>
    <div class="pitchwrap">
      <div class="pitch" id="pitch">
        <div class="line p-out"></div>
        <div class="line p-half"></div>
        <div class="line p-circle"></div>
        <div class="p-spot"></div>
        <div class="line p-box-b"></div><div class="line p-six-b"></div><div class="line p-arc-b"></div>
        <div class="line p-box-t"></div><div class="line p-six-t"></div><div class="line p-arc-t"></div>
      </div>
      <p class="pitchhint"><b>Drag a shirt</b> to move it. <b>Click a name</b> to set it. Arrow keys nudge a focused player.</p>
    </div>
    <div class="issues" id="issues"></div>
  </section>

  <!-- RIGHT: controls -->
  <div class="rightcol">

    <section class="card">
      <h2>Player <em id="editorWho"></em></h2>
      <div class="editor" id="editor"></div>
    </section>

    <section class="card">
      <h2>Weapons <em id="idxMeta"></em></h2>
      <div class="toolbar">
        <input type="text" id="search" placeholder="Search weapons">
        <div class="chips" id="chips"></div>
      </div>
      <div class="index" id="index"></div>
    </section>

  </div>
</div>

<footer class="shout">shoutout to: <b>desire</b> (@desired_11 on ds)</footer>
</div>

<dialog id="varDlg">
  <div class="dh" id="varTitle">Choose a variant</div>
  <div class="db" id="varBody"></div>
</dialog>

